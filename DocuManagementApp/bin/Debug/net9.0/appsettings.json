{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=documanagementdb;Username=postgres;Password=postgres"
  },
  "SearchProxy": {
    "Enabled": false,
    "BaseUrl": "http://localhost:5190",
    "ApiKey": ""
  },
  "PdfA": {
    "ContainerRuntimeExecutablePath": "",
    "GhostscriptImage": "docker.io/minidocks/ghostscript:latest",
    "VeraPdfRestBaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 120
  },
  "LibreOffice": {
    "ExecutablePath": "",
    "ContainerRuntimeExecutablePath": "",
    "ContainerImage": "docker.io/linuxserver/libreoffice:latest"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "documents.events",
    "Queue": "documents.ingested",
    "RoutingKey": "document.ingested",
    "BatchSize": 20,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 60,
    "ConfirmTimeoutSeconds": 10,
    "RetryBaseSeconds": 2,
    "RetryMaxSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
